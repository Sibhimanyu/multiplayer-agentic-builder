{
  // The Firebase build's own typecheck scope.
  //
  // A SEPARATE file rather than a change to tsconfig.json: the root config is part of the
  // promoted shared foundation and its `include` is `shared/**/*.ts` on purpose, so both
  // builds typecheck the same surface. Widening it here would silently change what the
  // Catalyst build checks too, which is the desynchronisation Order 0002 forbids.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The adapter, the CLI and the functions all import firebase-admin, which the shared
    // foundation deliberately does not depend on.
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "cli/**/*.ts", "functions/src/**/*.ts"]
}
