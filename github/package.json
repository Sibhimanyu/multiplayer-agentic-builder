{
  "name": "catalyst-builder-github",
  "private": true,
  "type": "module",
  "description": "Route G: GitHub-only adapter. Its own tree, its own test command -- root npm test stays exactly the shared suite, 19/19, per territory.md.",
  "scripts": {
    "test": "node --test \"store/*.test.ts\" \"cli/*.test.ts\" \"webhook/*.test.ts\" \"reaper.test.ts\"",
    "test:unit": "node --test store/transport.test.ts store/refs.test.ts store/provisioning.test.ts store/scope-invariants.test.ts cli/cli.test.ts webhook/map.test.ts reaper.test.ts",
    "test:live": "GITHUB_LIVE=1 node --test store/github.live.test.ts",
    "typecheck": "tsc --noEmit -p ../tsconfig.github.json",
    "g": "GITHUB_LIVE=1 node --test --test-timeout=7200000 demo/g-series.live.test.ts",
    "g1": "GITHUB_LIVE=1 node --test --test-timeout=7200000 --test-name-pattern=G1 demo/g-series.live.test.ts",
    "g2": "GITHUB_LIVE=1 node --test --test-timeout=7200000 --test-name-pattern=G2 demo/g-series.live.test.ts",
    "g34": "GITHUB_LIVE=1 node --test --test-timeout=7200000 --test-name-pattern=G3 demo/g-series.live.test.ts",
    "live:a4": "GITHUB_LIVE=1 node --test --test-timeout=900000 --test-name-pattern=\"A1 |A4 |A6 \" store/github.live.test.ts",
    "live:paging": "GITHUB_LIVE=1 node --test --test-timeout=2400000 --test-name-pattern=\"A1 |A4 |A5 |A6 |A11 |A13 |A16 \" store/github.live.test.ts",
    "g1b": "GITHUB_LIVE=1 node --test --test-timeout=1800000 --test-name-pattern=G1b demo/g-series.live.test.ts",
    "phase": "GITHUB_LIVE=1 node --test --test-timeout=1800000 --test-name-pattern=\"phase breakdown\" demo/g-series.live.test.ts"
  }
}
