# Route G: the dashboard's read path.
#
# There is no project id, no service-account key and no billing account --
# the repository IS the backend. These two values are the entire configuration.

VITE_GITHUB_REPO=Sibhimanyu/inventory-tracker-github

# A fine-grained PAT with READ-ONLY Contents access to that repository.
#
# The dashboard only reads. It never claims, releases, locks or appends, so a
# read-only token is sufficient and is what you should use -- a token with write
# scope in a browser bundle is a token anyone who loads the page can take.
VITE_GITHUB_TOKEN=github_pat_readonly_xxxxxxxxxxxx
