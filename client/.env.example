# Firebase web config for the dashboard.
#
# These values are PUBLIC by design: the web config identifies a project, it does not
# authorise anything. Authorisation is firestore.rules plus the coordination API. Shipping
# them in the bundle is correct.
#
# Copy to .env.local and fill in from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional; derived from PROJECT_ID when omitted.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
