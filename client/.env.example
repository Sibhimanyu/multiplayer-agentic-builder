# Firebase web config for the dashboard.
#
# These values are PUBLIC by design: the web config identifies a project, it does not
# authorise anything. Authorisation is firestore.rules plus the coordination API. Shipping
# them in the bundle is correct.
#
# Copy to .env.local and fill in from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database, which owns PRESENCE only. Decision 0003.
#
# The instance is in us-central1 while Firestore is in asia-south1. The user was shown the
# mismatch and chose to keep it: RTDB bills BANDWIDTH, not distance, so the cost figure is
# unaffected, and presence is not latency-critical -- the visible effect is an avatar ring
# settling a couple of hundred ms after a card moves.
#
# THE LABELLING RULE THAT COMES WITH IT: every presence figure carries us-central1, and none of
# them ever appears in a row with a Firestore number. Every other latency figure in this project
# is same-region by construction (asia-south1, client Asia/Kolkata, deliberately best-case).
# Presence is not, and a table that mixes them would read as one comparable set.
VITE_FIREBASE_DATABASE_URL=https://multiplayer-agents-eec02-default-rtdb.firebaseio.com

# Optional; derived from PROJECT_ID when omitted.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
