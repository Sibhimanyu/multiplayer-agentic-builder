{
  "name": "catalyst-builder-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared kanban dashboard. Both the Catalyst and Firebase builds render this; only src/store/* differs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node verify-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify-bundle": "node verify-bundle.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
