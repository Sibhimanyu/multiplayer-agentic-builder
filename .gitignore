# generated agent context, never committed
.agentic/
AGENTS.md

# workspace scratch (also in .git/info/exclude, but that does not travel to a clone)
.context/

# vendored gstack (deprecated; each dev installs their own)
.claude/skills/gstack/

node_modules/
dist/
.env
.env.local
*.log
.DS_Store
*.tsbuildinfo

# npm pack output; packtest.mjs removes its own, this catches a manual run
*.tgz

# agent credential, written by `flotilla connect`. NEVER commit this.
.flotilla-token
# Superseded names. Kept ignored ONLY so a stale credential written before a rename cannot be
# committed by accident -- nothing reads these, and that is deliberate: decision 0004 is a clean
# break, so `flotilla init` must not silently pick up a previous product's config.
.drydock-token
.builder-token

# compiled Cloud Functions deploy artifact
functions/lib/

# emulator noise
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# local Firebase web config for the dashboard
client/.env.local

# scratch commit-message file; the sandbox blocks writing to /tmp
.commitmsg

# Design-hook cache. Session-scoped tool state keyed by session id, not project source.
.impeccable/

# Bundled edge render, rebuilt on demand.
client/edge/.*-shot.mjs

# Written by scripts/emulator.sh when the default emulator port is busy.
.firebase-emulator-*.json
