catalyst/deploy/*
!catalyst/deploy/README.md

# vendored copies of functions/_lib, written by catalyst/tools/sync-lib.ts.
# Generated artifacts: never edit one, never commit one. The single source of
# truth is functions/_lib. Order 0006 section 3.
functions/*/_vendor/

# generated agent context, never committed
.agentic/
AGENTS.md

# workspace scratch (also in .git/info/exclude, but that does not travel to a clone)
.context/

# vendored gstack (deprecated; each dev installs their own)
.claude/skills/gstack/

