{
  "name": "bakeoff-firebase",
  "private": true,
  "type": "module",
  "description": "The Firebase half of the bake-off: the CoordinationStore adapter, its harness for the SHARED conformance suite, and the demo fixture.",
  "scripts": {
    "test": "cd .. && scripts/emul-groups.sh",
    "typecheck": "cd .. && tsc --noEmit -p tsconfig.firebase.json",
    "seed:demo": "cd .. && scripts/emulator.sh 'node firebase/seed-demo.ts'",
    "xcheck": "cd .. && scripts/xcheck.sh",
    "territory": "cd .. && scripts/territory-check.sh",
    "check": "cd .. && scripts/territory-check.sh && scripts/xcheck.sh",
    "test:conformance": "cd .. && scripts/emulator.sh 'scripts/run-tests.sh --test-concurrency=1 --test-timeout=900000 firebase/store.test.ts'",
    "check:live-rules": "node live-rules-check.mjs",
    "measure": "cd .. && node firebase/measure.ts",
    "test:directory": "cd .. && scripts/emulator.sh 'scripts/run-tests.sh --test-concurrency=1 --test-timeout=300000 firebase/directory.test.ts'",
    "test:integration": "cd .. && scripts/emulator.sh 'scripts/run-tests.sh --test-concurrency=1 --test-timeout=600000 firebase/scoping.test.ts firebase/reaper.test.ts functions/src/api.test.ts'",
    "test:stress": "cd .. && scripts/emulator.sh 'scripts/run-tests.sh --test-concurrency=1 --test-timeout=600000 firebase/concurrency.test.ts'"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase": "^12.18.0"
  }
}
